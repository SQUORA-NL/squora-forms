<Project>
  <PropertyGroup>
    <Authors>Squora</Authors>
    <Company>Squora</Company>
    <Copyright>Copyright (c) Squora</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SQUORA-NL/squora-forms</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SQUORA-NL/squora-forms</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>forms;json-schema;ui-schema;dynamic-forms;blazor</PackageTags>
    <VersionPrefix>1.0.0</VersionPrefix>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
