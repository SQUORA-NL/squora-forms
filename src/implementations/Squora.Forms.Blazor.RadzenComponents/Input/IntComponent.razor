@namespace Squora.Forms.Blazor.RadzenComponents.Input
@inherits Squora.Forms.Blazor.Components.Input.IntComponentBase

<BDFormComponentWrapper Class="intcomponent" FormComponent="@this">
    @if (!string.IsNullOrEmpty(Label))
    {
        <RadzenText>@Label</RadzenText>
    }
        <RadzenNumeric @bind-Value="@NumberValue" Disabled="@IsDisabled" />
</BDFormComponentWrapper>