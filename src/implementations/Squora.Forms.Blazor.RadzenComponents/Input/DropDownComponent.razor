@namespace Squora.Forms.Blazor.RadzenComponents.Input
@inherits Squora.Forms.Blazor.Components.Input.DropDownComponentBase

<BDFormComponentWrapper Class="dropdowncomponent" FormComponent="@this">
    @if (!string.IsNullOrEmpty(Label))
    {
        <RadzenText>@Label</RadzenText>
    }
    <RadzenDropDown @bind-Value=@SelectedValue Data=@Options ValueProperty="Key" TextProperty="Value" Style="width: 100%; max-width: 400px;" Disabled="@IsDisabled" />
</BDFormComponentWrapper>