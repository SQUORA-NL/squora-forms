@namespace Squora.Forms.Blazor.SyncfusionComponents.Layout
@inherits Squora.Forms.Blazor.Components.Layout.HorizontalLayoutBase

<BDFormComponentWrapper Class="horizontalcomponent" FormComponent="@this">
    <div class="sf-horizontal-layout @(EditMode ? "edit-mode" : "") @(isDragging ? "dragging-active" : "")">
        @if (EditMode)
        {
            @for (int i = 0; i < this.FormModel.Elements.Count; i++)
            {
                var index = i;
                var element = this.FormModel.Elements[i];

                <div class="bd-drop-zone @(dragOverIndex == index ? "drag-over" : "")"
                     @ondragover="@((e) => OnDragOver(e, index))"
                     @ondragover:preventDefault="true"
                     @ondragleave="@OnDragLeave"
                     @ondrop="@((e) => OnDrop(e, index))">
                    <div class="bd-drop-indicator">Drop here</div>
                </div>

                <div class="bd-draggable-element @(isDragging && draggedIndex == index ? "dragging" : "")">
                    <div class="bd-drag-handle"
                         draggable="true"
                         @ondragstart="@((e) => OnDragStart(e, index))"
                         @ondragstart:stopPropagation="true"
                         @ondragend="@OnDragEnd">⋮⋮</div>
                    <div class="bd-element-content">
                        <DynamicComponent Type=@GetComponentTypeFor(element) Parameters=@GetValidParametersForChild(element, index) />
                    </div>
                </div>
            }

            <div class="bd-drop-zone @(dragOverIndex == this.FormModel.Elements.Count ? "drag-over" : "")"
                 @ondragover="@((e) => OnDragOver(e, this.FormModel.Elements.Count))"
                 @ondragover:preventDefault="true"
                 @ondragleave="@OnDragLeave"
                 @ondrop="@((e) => OnDrop(e, this.FormModel.Elements.Count))">
                <div class="bd-drop-indicator">Drop here</div>
            </div>
        }
        else
        {
            @for (int i = 0; i < this.FormModel.Elements.Count; i++)
            {
                var element = this.FormModel.Elements[i];
                <DynamicComponent Type=@GetComponentTypeFor(element) Parameters=@GetValidParametersForChild(element, i) />
            }
        }
    </div>
</BDFormComponentWrapper>
