@namespace Squora.Forms.Blazor.MudBlazorComponents.Input
@inherits Squora.Forms.Blazor.Components.Input.NumberComponentBase

<BDFormComponentWrapper Class="numbercomponent" FormComponent="@this" ShowValidation="false">
    <MudNumericField @bind-Value="@NumberValue" Label="@Label" Validation="@(new Func<int, string>(ValueValidation))" Variant="Variant.Outlined" Step="@Step" Disabled="@IsDisabled" />
</BDFormComponentWrapper>

@code{

    [Parameter]
    public double Step {get;set;} = 1;

    private string ValueValidation(int arg)
    {
        if (!IsValid)
            return ValidationString;
        return null;
    }
}