@namespace Squora.Forms.Blazor.MudBlazorComponents.Input
@inherits Squora.Forms.Blazor.Components.Input.IntComponentBase

<BDFormComponentWrapper Class="intcomponent" FormComponent="@this" ShowValidation="false">
    <MudNumericField @bind-Value="@NumberValue" Validation="@(new Func<int, string>(ValueValidation))" Label="@Label" Variant="Variant.Outlined" Disabled="@IsDisabled" />
</BDFormComponentWrapper>

@code {

    private string ValueValidation(int arg)
    {
        if (!IsValid)
            return ValidationString;
        return null;
    }
}