@namespace Squora.Forms.Blazor.MudBlazorComponents.Input
@inherits Squora.Forms.Blazor.Components.Input.DropDownComponentBase

<BDFormComponentWrapper Class="dropdowncomponent" FormComponent="@this" ShowValidation="false">
    <MudSelect @bind-Value="@SelectedValue" Label="@Label" Variant="Variant.Outlined" Validation="@(new Func<string, string>(ValueMatch))" Disabled="@IsDisabled">
        @foreach (var item in Options)
        {
            <MudSelectItem Value="@item.Key">
                @item.Value
            </MudSelectItem>
        }
    </MudSelect>
</BDFormComponentWrapper>

@code{
         
    private string ValueMatch(string arg)
    {
        if(!IsValid)
            return ValidationString;
        return null;
    }
 }