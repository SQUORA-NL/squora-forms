<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <Description>MudBlazor implementation of the Squora Forms Blazor components.</Description>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.10" />
    <PackageReference Include="MudBlazor" Version="8.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Squora.Forms.Blazor.Components\Squora.Forms.Blazor.Components.csproj" />
    <ProjectReference Include="..\..\Squora.Forms.Blazor.Extensions\Squora.Forms.Blazor.Extensions.csproj" />
    <ProjectReference Include="..\..\Squora.Forms.Blazor.Actions\Squora.Forms.Blazor.Actions.csproj" />
  </ItemGroup>

</Project>
