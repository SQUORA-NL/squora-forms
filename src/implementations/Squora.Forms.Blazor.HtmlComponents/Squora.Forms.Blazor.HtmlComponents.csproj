<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <Description>Plain HTML implementation of the Squora Forms Blazor components. No third-party UI library required.</Description>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Squora.Forms.Blazor.Components\Squora.Forms.Blazor.Components.csproj" />
    <ProjectReference Include="..\..\Squora.Forms.Blazor.Extensions\Squora.Forms.Blazor.Extensions.csproj" />
    <ProjectReference Include="..\..\Squora.Forms.Blazor.Actions\Squora.Forms.Blazor.Actions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Actions\DeleteAction.razor">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

</Project>
