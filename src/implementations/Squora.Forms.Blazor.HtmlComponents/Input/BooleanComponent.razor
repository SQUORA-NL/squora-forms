@namespace Squora.Forms.Blazor.HtmlComponents.Input
@inherits Squora.Forms.Blazor.Components.Input.BooleanComponentBase

<BDFormComponentWrapper Class="boolcomponent" FormComponent="@this">
    <input type="checkbox" id="@ComponentId" @bind="@BooleanValue"
           disabled="@IsDisabled"
           aria-invalid="@(IsInvalid ? "true" : null)"
           aria-required="@(Required ? "true" : null)"
           aria-describedby="@ErrorMessageId" />
    <label for="@ComponentId" class="bd-label">
        @Label
        @if (Required)
        {
            <span class="bd-required-indicator" aria-hidden="true">*</span>
            <span class="sr-only">required</span>
        }
    </label>
</BDFormComponentWrapper>