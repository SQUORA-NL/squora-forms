@namespace Squora.Forms.Blazor.Components
@inject IServiceProvider Services

@* Every component draws itself inside this wrapper. It is the same wrapper for every component and every UI library; what it draws is the plain
   one, or, when an editor registered an IFormEditSurface, the editor's. A custom component has to be drawn inside it to get its class, style
   and width, validation and (in an editor) selection. *@
<DynamicComponent Type="@wrapperType" Parameters="@WrapperParameters" />

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public FormComponentBase? FormComponent { get; set; }
    [Parameter] public bool ShowValidation { get; set; } = true;

    /// <summary>Kept for the components that set it; what the wrapper does while editing is up to the form component's own <see cref="FormComponentBase.EditMode"/>.</summary>
    [Parameter] public bool EditMode { get; set; } = false;

    private Type wrapperType = typeof(PlainElementWrapper);

    protected override void OnInitialized()
    {
        wrapperType = Services.GetService(typeof(IFormEditSurface)) is IFormEditSurface surface
            ? surface.ElementWrapperType
            : typeof(PlainElementWrapper);
    }

    private IDictionary<string, object?> WrapperParameters => new Dictionary<string, object?>
    {
        [nameof(ElementWrapperBase.Class)] = Class,
        [nameof(ElementWrapperBase.ChildContent)] = ChildContent,
        [nameof(ElementWrapperBase.FormComponent)] = FormComponent,
        [nameof(ElementWrapperBase.ShowValidation)] = ShowValidation,
    };
}
