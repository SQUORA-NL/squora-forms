@using Squora.Forms.Blazor
@using Squora.Forms.Blazor.Components
@using Squora.Forms.Blazor.Services
@using Squora.Forms.Common.Enums
@namespace Squora.Forms.Blazor.Components

<div class="@($"{Class} {FormComponent.Class} {(IsSelected ? "bd-selected" : "")} {(EditMode ? "bd-editable" : "")} {(EditMode && FormComponent is IDragContainer ? "bd-container" : "")} {(EditMode && IsDragging ? "bd-drag-active" : "")} {(IsDragSource ? "bd-dragging" : "")} {(IsDropTarget ? "bd-drop-target" : "")} {(FormComponent?.IsDisabled == true ? "bd-disabled" : "")}".Trim())"
     style="@FormComponent?.ItemStyle"
     data-drop-label="@(IsDropTarget ? DropLabel : null)"
     aria-live="polite"
     aria-disabled="@(FormComponent?.IsDisabled == true ? "true" : null)"
     @onclick="@OnElementClick"
     @onclick:stopPropagation="true"
     @ondblclick="@OnElementDoubleClick"
     @ondblclick:stopPropagation="true"
     @onfocusout="OnFocusOut">
    @* while editing, a component a rule hides stays in view (otherwise it could not be selected again) *@
    @if (EditMode || (FormComponent?.RuleEffect ?? RuleEffect.SHOW) != RuleEffect.HIDE)
    {
        @ChildContent
    }
    @if (EditMode && FormComponent?.RuleEffect == RuleEffect.HIDE)
    {
        <span class="bd-rule-badge" title="A rule hides this while the form is filled in">Hidden by a rule</span>
    }
    @if (EditMode && FormComponent?.Parent is IDragContainer)
    {
        <BDEditChrome FormComponent="FormComponent" />
    }
    @if (ShowValidation && (!FormComponent?.IsValid ?? true))
    {
        <div class="bd-validation" id="@(FormComponent?.ErrorMessageId)" role="alert">@(FormComponent?.ValidationString??"")</div>
    }
</div>