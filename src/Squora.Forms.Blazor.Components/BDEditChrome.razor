@namespace Squora.Forms.Blazor.Components
@using Squora.Forms.Blazor
@using Squora.Forms.Blazor.Services
@using Squora.Forms.Blazor.Utillities
@implements IDisposable

@if (Container != null && Index >= 0)
{
    @* The tag above the element: what it is, a handle to move it by and, once selected, what can be done with it. *@
    <div class="bd-tag @(IsSelected ? "selected" : "")" style="z-index:@(100 + Depth)">
        <div class="bd-handle" role="button" aria-label="Drag to move @TypeName" title="Drag to move this element"
             draggable="true"
             @ondragstart="@(() => Container.BeginDrag(Index))"
             @ondragstart:stopPropagation="true"
             @ondragend="@(() => Container.EndDrag())"><span class="bd-grip" aria-hidden="true">⋮⋮</span>@TypeName</div>
        @if (IsSelected)
        {
            <div class="bd-actions" role="toolbar" aria-label="Actions for the selected @TypeName">
                <button type="button" class="bd-act bd-act-props" title="Edit its properties" aria-label="Edit properties"
                        @onclick="EditProperties" @onclick:stopPropagation="true">@EditorIcons.Settings</button>
                <button type="button" class="bd-act bd-act-parent" title="Select the layout it is in" aria-label="Select parent"
                        @onclick="SelectParent" @onclick:stopPropagation="true">@EditorIcons.Parent</button>
                <button type="button" class="bd-act bd-act-copy" title="Duplicate" aria-label="Duplicate"
                        @onclick="Duplicate" @onclick:stopPropagation="true">@EditorIcons.Copy</button>
                <button type="button" class="bd-act bd-act-delete" title="Delete" aria-label="Delete"
                        @onclick="Delete" @onclick:stopPropagation="true">@EditorIcons.Trash</button>
            </div>
        }
    </div>

    @if (IsSource)
    {
        @* The element being moved covers its own area, so dropping on it does nothing instead of falling through to the layout around it. *@
        <div class="bd-shield"
             style="z-index:@(10 + Depth)"
             @ondragover="@KeepDropTarget"
             @ondragover:preventDefault="true"
             @ondrop:preventDefault="true"></div>
    }

    @if (ShowZones)
    {
        @foreach (var side in sides)
        {
            <div class="bd-zone @(Container.IsHorizontal ? "h" : "v") @(side == 0 ? "before" : "after") @(over == side ? "over" : "")"
                 style="z-index:@(10 + Depth)"
                 data-hint="@Hint(side)"
                 @ondragenter="@(() => Enter(side))"
                 @ondragleave="@(() => Leave(side))"
                 @ondragover="@KeepDropTarget"
                 @ondragover:preventDefault="true"
                 @ondrop:preventDefault="true"
                 @ondrop="@(() => OnDrop(side))"></div>
        }
    }
}

@code {
    // Blazor only listens for dragover on elements that also have a handler, and the default (no drop allowed) must be prevented for drop to fire.
    private void KeepDropTarget() { }

    private static readonly int[] sides = { 0, 1 };

    // 0 = the drop target before this element is hovered, 1 = the one after it, -1 = none
    private int over = -1;

    // the spots under the pointer are told apart by these, so a late "leave" of one cannot clear the "enter" of the next
    private readonly object[] zoneKeys = { new(), new() };

    [Parameter, EditorRequired] public FormComponentBase FormComponent { get; set; } = null!;

    [CascadingParameter] public DragStateService? DragState { get; set; }

    [CascadingParameter] public SelectionStateService? SelectionState { get; set; }

    private IDragContainer? Container => FormComponent.Parent as IDragContainer;

    private string TypeName => FormTree.TypeName(FormComponent.FormModel);

    private int Index => Container?.IndexOf(FormComponent.FormModel) ?? -1;

    private bool IsSelected => SelectionState?.IsSelected(FormComponent.FormModel) == true;

    // Deeper elements get a higher z-index so their targets win over those of the layouts around them.
    // (counted through Parent: custom layouts don't necessarily hand out a TreePosition)
    private int Depth
    {
        get
        {
            var depth = 1;
            for (var parent = FormComponent.Parent; parent != null; parent = parent.Parent)
            {
                depth++;
            }
            return depth;
        }
    }

    private bool IsSource => DragState?.IsDragging == true && DragState.DraggedElement == FormComponent.FormModel;

    private bool ShowZones => DragState?.IsDragging == true && !IsSource;

    // what a drop on this side does, in words: "Drop above City"
    private string Hint(int side)
    {
        var name = FormTree.Describe(FormComponent.FormModel);
        var place = (Container?.IsHorizontal == true ? (side == 0 ? "left of" : "right of") : (side == 0 ? "above" : "below"));
        return $"Drop {place} {name}";
    }

    private void Enter(int side)
    {
        over = side;
        DragState?.SetHover(zoneKeys[side], Container?.ContainerModel, Hint(side));
    }

    private void Leave(int side)
    {
        if (over == side) over = -1;
        DragState?.ClearHover(zoneKeys[side]);
    }

    protected override void OnInitialized()
    {
        if (DragState != null)
        {
            DragState.StateChanged += OnDragStateChanged;
        }
    }

    private void OnDragStateChanged()
    {
        if (DragState?.IsDragging != true)
        {
            over = -1;
        }
        InvokeAsync(StateHasChanged);
    }

    private void OnDrop(int side)
    {
        over = -1;
        Container?.Drop(side == 0 ? Index : Index + 1);
    }

    private void EditProperties() => SelectionState?.EditProperties(FormComponent.FormModel);

    private void SelectParent() => SelectionState?.SelectParent();

    private void Duplicate() => SelectionState?.DuplicateSelected();

    private void Delete() => SelectionState?.DeleteSelected();

    public void Dispose()
    {
        if (DragState != null)
        {
            DragState.StateChanged -= OnDragStateChanged;
        }
    }
}
