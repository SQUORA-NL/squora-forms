@namespace Squora.Forms.Blazor.Components
@inject IServiceProvider Services

@* What a layout shows while it has no elements and a form is being edited: the editor's place to drop one (see IFormEditSurface). Without an editor nothing. *@
@if (Services.GetService(typeof(IFormEditSurface)) is IFormEditSurface surface)
{
    <DynamicComponent Type="@surface.EmptyLayoutType" Parameters="@(new Dictionary<string, object?> { ["Container"] = Container })" />
}

@code {
    /// <summary>The layout this stands in for.</summary>
    [Parameter, EditorRequired] public FormComponentBase Container { get; set; } = null!;
}
