@inherits Squora.Forms.Blazor.Components.LayoutFormComponent

<div class="sq-dynamicform">
    <CascadingValue Value="validationStateService" IsFixed="true">
        <CascadingValue Value="FormModel" IsFixed="true">
            @* bd-stage and bd-sheet are always there (what the form is on, and the form's own page), so a theme can style a form with them *@
            <div class="@Join("bd-stage", StageClass)">
                <div class="@Join("bd-sheet", SheetClass)">
                    <DynamicComponent Type=@componentType Parameters=@validParameters />
                </div>
            </div>
        </CascadingValue>
    </CascadingValue>
</div>
