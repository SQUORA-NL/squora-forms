@namespace Squora.Forms.Blazor

<div class="bd-edit-mode-toggle">
    <label class="bd-toggle-label">
        <input type="checkbox" 
               class="bd-toggle-input" 
               checked="@EditMode" 
               @onchange="@OnToggleChanged" />
        <span class="bd-toggle-slider"></span>
        <span class="bd-toggle-text">@(EditMode ? "Edit Mode" : "View Mode")</span>
    </label>
</div>

@code {
    [Parameter] public bool EditMode { get; set; }
    [Parameter] public EventCallback<bool> EditModeChanged { get; set; }

    private async Task OnToggleChanged(ChangeEventArgs e)
    {
        var newValue = e.Value is true;
        EditMode = newValue;
        await EditModeChanged.InvokeAsync(newValue);
    }
}