<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <Description>Blazor renderer base for Squora Forms: form component, layout and state services.</Description>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <InternalsVisibleTo Include="Squora.Forms.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Squora.Forms.Core\Squora.Forms.Core.csproj" />
    <ProjectReference Include="..\Squora.Forms.UISchema\Squora.Forms.UISchema.csproj" />
  </ItemGroup>

</Project>
