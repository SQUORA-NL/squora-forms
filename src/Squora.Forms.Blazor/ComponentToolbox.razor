@using Squora.Forms.Common.Enums
@using Squora.Forms.Core.Models
@using Squora.Forms.Core.Models.ParameterModels
@using Squora.Forms.Blazor.Services
@using Squora.Forms.Blazor.Utillities
@implements IDisposable
@inject ComponentsList Components

<div class="bd-component-toolbox">
    <div class="bd-toolbox-title">
        <h4>Components</h4>
        <p>Drag one onto the form, or click it to add it.</p>
    </div>
    @foreach (var group in Groups)
    {
        <div class="bd-toolbox-group" role="group" aria-label="@group.Title">
            <div class="bd-toolbox-group-title">@group.Title</div>
            <div class="bd-toolbox-content">
                @foreach (var componentType in group.Types)
                {
                    <div class="bd-toolbox-item"
                         role="button"
                         tabindex="0"
                         draggable="true"
                         title="Drag onto the form, or click to add"
                         @onclick="@(() => Add(componentType))"
                         @onclick:stopPropagation="true"
                         @onkeydown="@(e => OnItemKey(e, componentType))"
                         @ondragstart="@((e) => OnToolboxItemDragStart(e, componentType))"
                         @ondragend="@OnToolboxItemDragEnd">
                        <span class="bd-toolbox-item-icon">@EditorIcons.For(componentType)</span>
                        <span class="bd-toolbox-item-label">@GetComponentDisplayName(componentType)</span>
                        <span class="bd-toolbox-item-add" aria-hidden="true">@EditorIcons.Plus</span>
                    </div>
                }
            </div>
        </div>
    }
    <p class="bd-toolbox-target"><span>A click adds it</span> @AddTarget</p>
</div>

@code {
    [CascadingParameter] 
    public DragStateService? DragState { get; set; }

    [CascadingParameter]
    public DynamicFormModel? RootModel { get; set; }

    [CascadingParameter]
    public SelectionStateService? SelectionState { get; set; }

    private record Group(string Title, ComponentType[] Types);

    private static readonly Group[] Groups =
    {
        new("Fields", new[] { ComponentType.String, ComponentType.Boolean, ComponentType.Int, ComponentType.Number, ComponentType.DateTime, ComponentType.Dropdown }),
        new("Layout", new[] { ComponentType.VerticalLayout, ComponentType.HorizontalLayout, ComponentType.GroupLayout, ComponentType.List })
    };

    protected override void OnInitialized()
    {
        if (SelectionState != null)
        {
            SelectionState.StateChanged += OnSelectionChanged;
        }
    }

    private void OnSelectionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (SelectionState != null)
        {
            SelectionState.StateChanged -= OnSelectionChanged;
        }
    }

    // where a click on a component puts it: the same rule FormTree.Add follows
    private string AddTarget
    {
        get
        {
            var selected = SelectionState?.SelectedElement;
            if (selected == null || selected == RootModel) return "at the end of the form.";
            return FormTree.IsContainer(selected)
                ? $"inside {FormTree.Describe(selected)}."
                : $"after {FormTree.Describe(selected)}.";
        }
    }

    private void Add(ComponentType componentType)
    {
        if (SelectionState == null) return;

        var newComponent = CreateComponentModel(componentType);
        MakePathUnique(newComponent);
        SelectionState.AddElement(newComponent);
    }

    private void OnItemKey(KeyboardEventArgs e, ComponentType componentType)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            Add(componentType);
        }
    }

    private void OnToolboxItemDragStart(DragEventArgs e, ComponentType componentType)
    {
        if (DragState == null) return;
        
        // Create a new component model for dragging
        var newComponent = CreateComponentModel(componentType);
        MakePathUnique(newComponent);
        DragState.StartToolboxDrag(newComponent);
    }

    private void OnToolboxItemDragEnd(DragEventArgs e)
    {
        if (DragState == null) return;
        DragState.EndDrag();
    }

    private DynamicFormModel CreateComponentModel(ComponentType componentType)
    {
        return componentType switch
        {
            ComponentType.String => new DynamicFormModel
            {
                DynamicType = new ComponentSelectionKey(ComponentType.String),
                Parameters = new ParameterList().Add("Label", "New Text Field").Add("Path", "$.newField")
            },
            ComponentType.Boolean => new DynamicFormModel
            {
                DynamicType = new ComponentSelectionKey(ComponentType.Boolean),
                Parameters = new ParameterList().Add("Label", "New Checkbox").Add("Path", "$.newBool")
            },
            ComponentType.Int => new DynamicFormModel
            {
                DynamicType = new ComponentSelectionKey(ComponentType.Int),
                Parameters = new ParameterList().Add("Label", "New Number").Add("Path", "$.newNumber")
            },
            ComponentType.Number => new DynamicFormModel
            {
                DynamicType = new ComponentSelectionKey(ComponentType.Number),
                Parameters = new ParameterList().Add("Label", "New Decimal").Add("Path", "$.newDecimal")
            },
            ComponentType.DateTime => new DynamicFormModel
            {
                DynamicType = new ComponentSelectionKey(ComponentType.DateTime),
                Parameters = new ParameterList().Add("Label", "New Date").Add("Path", "$.newDate")
            },
            ComponentType.Dropdown => new DynamicFormModel
            {
                DynamicType = new ComponentSelectionKey(ComponentType.Dropdown),
                Parameters = new ParameterList().Add("Label", "New Dropdown").Add("Path", "$.newDropdown")
                    .Add("Options", new Dictionary<object, string> { { "option1", "Option 1" } })
            },
            ComponentType.VerticalLayout => new DynamicFormModel
            {
                DynamicType = new ComponentSelectionKey(ComponentType.VerticalLayout),
                Elements = new List<DynamicFormModel>()
            },
            ComponentType.HorizontalLayout => new DynamicFormModel
            {
                DynamicType = new ComponentSelectionKey(ComponentType.HorizontalLayout),
                Elements = new List<DynamicFormModel>()
            },
            ComponentType.GroupLayout => new DynamicFormModel
            {
                DynamicType = new ComponentSelectionKey(ComponentType.GroupLayout),
                Parameters = new ParameterList().Add("Label", "New Group"),
                Elements = new List<DynamicFormModel>()
            },
            ComponentType.List => new DynamicFormModel
            {
                DynamicType = new ComponentSelectionKey(ComponentType.List),
                Parameters = new ParameterList().Add("Label", "New List").Add("Path", "$.newList"),
                Elements = new List<DynamicFormModel>()
            },
            _ => new DynamicFormModel
            {
                DynamicType = new ComponentSelectionKey(ComponentType.String),
                Parameters = new ParameterList().Add("Label", "New Field").Add("Path", "$.newField")
            }
        };
    }

    // New fields would all bind to the same default path (and so share one value), so a number is added when it is taken.
    private void MakePathUnique(DynamicFormModel component)
    {
        if (RootModel == null || !component.Parameters.Entries.TryGetValue("Path", out var path) || path is not string basePath) return;

        component.Parameters.Add("Path", Utillities.UniquePath.For(RootModel, basePath));
    }

    private static string GetComponentDisplayName(ComponentType componentType) => FormTree.DisplayName(componentType);
}
