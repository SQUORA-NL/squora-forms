@implements IDisposable
@using Squora.Forms.Common.Enums
@using Squora.Forms.Core.Models
@using Squora.Forms.Core.Models.ParameterModels
@using Squora.Forms.Core.Parser
@using Squora.Forms.Blazor
@using Squora.Forms.Blazor.Services
@using Squora.Forms.Blazor.Utillities

<div class="bd-property-editor">
    @if (SelectionState?.SelectedElement != null)
    {
        var element = SelectionState.SelectedElement;
        var componentType = element.DynamicType.ComponentType;
        var isRoot = element == RootModel;
        var typeName = element.DynamicType.TypeDefinitionName;

        <div class="bd-property-editor-header">
            <span class="bd-pe-badge" aria-hidden="true">@EditorIcons.For(componentType)</span>
            <div class="bd-pe-title">
                <h4>@(isRoot ? "Whole form" : FormTree.Describe(element))</h4>
                <span class="bd-pe-subtitle">@(isRoot ? "The form itself · " : "")@GetComponentDisplayName(componentType)@(string.IsNullOrEmpty(typeName) ? "" : $" · {typeName}")</span>
            </div>
            <div class="bd-pe-header-actions">
                @if (SelectionState != null && SelectionState.CanSelectParent)
                {
                    <button type="button" class="bd-icon-button bd-parent-button" @onclick="SelectParent" title="Select the layout this element is in" aria-label="Select parent">@EditorIcons.Parent</button>
                }
                @if (!isRoot)
                {
                    <button type="button" class="bd-icon-button bd-copy-button" @onclick="Duplicate" title="Duplicate this element" aria-label="Duplicate">@EditorIcons.Copy</button>
                    <button type="button" class="bd-icon-button bd-delete-button" @onclick="DeleteSelectedElement" title="Delete this element" aria-label="Delete">@EditorIcons.Trash</button>
                }
                <button type="button" class="bd-icon-button bd-close-button" @onclick="Close" title="Hide the properties" aria-label="Hide the properties">@EditorIcons.Close</button>
            </div>
        </div>
        <div class="bd-pe-tabs" role="tablist">
            <button role="tab" aria-selected="@(activeTab == EditorTab.Properties)" class="bd-tab @(activeTab == EditorTab.Properties ? "active" : "")" @onclick="@(() => SetTab(EditorTab.Properties))">Properties</button>
            <button role="tab" aria-selected="@(activeTab == EditorTab.Rules)" class="bd-tab bd-rules-tab @(activeTab == EditorTab.Rules ? "active" : "")" @onclick="@(() => SetTab(EditorTab.Rules))">Rules@(element.Rules?.Count > 0 ? $" ({element.Rules.Count})" : "")</button>
            <button role="tab" aria-selected="@(activeTab == EditorTab.Json)" class="bd-tab bd-json-toggle-button @(activeTab == EditorTab.Json ? "active" : "")" @onclick="ToggleJsonView" title="Toggle JSON View">JSON</button>
        </div>

        <div class="bd-property-editor-content">
            @if (activeTab == EditorTab.Properties)
            {
                @if (HasLabelProperty(componentType))
                {
                    <div class="bd-property-group">
                        <label class="bd-property-label">Label</label>
                        <input class="bd-property-input"
                               @ref="labelInput"
                               type="text"
                               value="@GetParameterValue(element, "Label")"
                               @onchange="@((e) => UpdateParameter(element, "Label", e.Value?.ToString()))" />
                    </div>
                }

                @if (HasPathProperty(componentType))
                {
                    <div class="bd-property-group">
                        <label class="bd-property-label">Path</label>
                        <input class="bd-property-input"
                               type="text"
                               value="@GetParameterValue(element, "Path")"
                               @onchange="@((e) => UpdateParameter(element, "Path", e.Value?.ToString()))" />
                    </div>
                }

                @if (componentType == ComponentType.Dropdown)
                {
                    <div class="bd-property-group">
                        <label class="bd-property-label">Options</label>
                        <div class="bd-options-editor">
                            @{
                                var options = GetDropdownOptions(element);
                            }
                            @foreach (var option in options)
                            {
                                <div class="bd-option-row">
                                    <input class="bd-option-key"
                                           type="text"
                                           placeholder="Value"
                                           value="@option.Key?.ToString()"
                                           @onchange="@((e) => UpdateOptionKey(element, option.Key, e.Value?.ToString()))" />
                                    <input class="bd-option-label"
                                           type="text"
                                           placeholder="Display Text"
                                           value="@option.Value"
                                           @onchange="@((e) => UpdateOptionValue(element, option.Key, e.Value?.ToString()))" />
                                    <button class="bd-remove-option" @onclick="@(() => RemoveOption(element, option.Key))">Remove</button>
                                </div>
                            }
                            <button class="bd-add-option" @onclick="@(() => AddOption(element))">+ Add Option</button>
                        </div>
                    </div>
                }

                @if (componentType == ComponentType.Boolean)
                {
                    <div class="bd-property-group">
                        <label class="bd-property-label">
                            <input type="checkbox"
                                   checked="@GetBooleanParameter(element, "Required")"
                                   @onchange="@((e) => UpdateParameter(element, "Required", (bool?)e.Value))" />
                            Required
                        </label>
                    </div>
                }

                @if (IsNumberComponent(componentType))
                {
                    <div class="bd-property-group">
                        <label class="bd-property-label">Min Value</label>
                        <input class="bd-property-input"
                               type="number"
                               value="@GetParameterValue(element, "Min")"
                               @onchange="@((e) => UpdateNumericParameter(element, "Min", e.Value?.ToString()))" />
                    </div>
                    <div class="bd-property-group">
                        <label class="bd-property-label">Max Value</label>
                        <input class="bd-property-input"
                               type="number"
                               value="@GetParameterValue(element, "Max")"
                               @onchange="@((e) => UpdateNumericParameter(element, "Max", e.Value?.ToString()))" />
                    </div>
                }

                @* the other settings a component has (a custom component type brings its own) *@
                @foreach (var setting in OtherSettings(element))
                {
                    var name = setting.Key;
                    <div class="bd-property-group bd-setting">
                        <label class="bd-property-label">
                            @if (setting.Value is bool flag)
                            {
                                <input type="checkbox" checked="@flag" @onchange="@((e) => UpdateParameter(element, name, (bool?)e.Value))" />
                            }
                            @Humanize(name)
                        </label>
                        @if (setting.Value is null or string)
                        {
                            <input class="bd-property-input" type="text" value="@(setting.Value as string)" @onchange="@((e) => UpdateParameter(element, name, e.Value?.ToString()))" />
                        }
                        else if (IsNumber(setting.Value))
                        {
                            <input class="bd-property-input" type="number" value="@Convert.ToString(setting.Value, System.Globalization.CultureInfo.InvariantCulture)" @onchange="@((e) => UpdateSettingNumber(element, name, e.Value?.ToString()))" />
                        }
                        else if (setting.Value is not bool)
                        {
                            <div class="bd-help">Edit this one in the JSON tab.</div>
                        }
                    </div>
                }
            }
            else if (activeTab == EditorTab.Rules)
            {
                <div class="bd-help">
                    A rule changes this component while the form data matches a condition. The condition looks at a path in the data and checks that it equals a value (or matches a JSON schema).
                </div>
                var rules = element.Rules ?? new List<DynamicFormModelRule>();
                @for (var i = 0; i < rules.Count; i++)
                {
                    var index = i;
                    var rule = rules[i];
                    <div class="bd-rule">
                        <div class="bd-rule-head">
                            <select class="bd-property-input bd-rule-effect" value="@rule.Effect" @onchange="@((e) => UpdateRuleEffect(element, index, e.Value?.ToString()))">
                                @foreach (var effect in Enum.GetValues<RuleEffect>())
                                {
                                    <option value="@effect" selected="@(effect == rule.Effect)">@EffectLabel(effect)</option>
                                }
                            </select>
                            <button class="bd-remove-option bd-remove-rule" @onclick="@(() => RemoveRule(element, index))" title="Remove this rule">Remove</button>
                        </div>
                        <div class="bd-help">@EffectHelp(rule.Effect)</div>
                        <label class="bd-property-label">Path in the data</label>
                        <input class="bd-property-input bd-rule-scope" type="text" placeholder="$.country" value="@rule.Condition.Scope"
                               @onchange="@((e) => UpdateRuleScope(element, index, e.Value?.ToString()))" />
                        @if (IsSimpleRule(rule, out var simpleValue) && !ruleAdvanced.Contains(index))
                        {
                            <label class="bd-property-label">Equals</label>
                            <input class="bd-property-input bd-rule-value" type="text" placeholder="true" value="@simpleValue"
                                   @onchange="@((e) => UpdateRuleValue(element, index, e.Value?.ToString()))" />
                            <div class="bd-help">true, false, a number or text.
                                <button class="bd-link-button bd-rule-advanced" @onclick="@(() => ruleAdvanced.Add(index))">Use a JSON schema instead</button>
                            </div>
                        }
                        else
                        {
                            <label class="bd-property-label">Must match this JSON schema</label>
                            <textarea class="bd-rule-schema" rows="3" spellcheck="false" placeholder='{ "const": "nl" }'
                                      value="@(ruleDrafts.TryGetValue(index, out var draft) ? draft : rule.Condition.Schema?.ToString(Newtonsoft.Json.Formatting.None))"
                                      @onchange="@((e) => UpdateRuleSchema(element, index, e.Value?.ToString()))"></textarea>
                        }
                        @if (ruleErrors.TryGetValue(index, out var error))
                        {
                            <div class="bd-json-error">@error</div>
                        }
                    </div>
                }
                <button class="bd-add-option bd-add-rule" @onclick="@(() => AddRule(element))">+ Add Rule</button>
            }
            else
            {
                <div class="bd-property-group">
                    <div class="bd-json-head">
                        <label class="bd-property-label">
                            @if (isFullFormJsonMode || isRoot)
                            {
                                <span>Full Form JSON</span>
                            }
                            else
                            {
                                <span>Element JSON</span>
                            }
                        </label>
                        @if (!isRoot)
                        {
                            <button class="bd-json-mode-button @(isFullFormJsonMode ? "active" : "")" @onclick="ToggleJsonMode" title="Toggle JSON Mode">
                                @(isFullFormJsonMode ? "Form" : "Element")
                            </button>
                        }
                    </div>
                    <textarea class="bd-json-editor"
                              rows="15"
                              spellcheck="false"
                              @bind="currentJsonContent"
                              @oninput="OnJsonChanged"></textarea>
                    <div class="bd-json-buttons">
                        <button class="bd-apply-json-button" @onclick="ApplyJsonChanges">Apply Changes</button>
                        @if (hasJsonError)
                        {
                            <div class="bd-json-error">Invalid JSON format</div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="bd-property-editor-header bd-pe-plain">
            <div class="bd-pe-title">
                <h4>Properties</h4>
            </div>
            <div class="bd-pe-header-actions">
                <button type="button" class="bd-icon-button bd-close-button" @onclick="Close" title="Hide the properties" aria-label="Hide the properties">@EditorIcons.Close</button>
            </div>
        </div>
        <div class="bd-property-editor-empty">
            <span class="bd-empty-badge" aria-hidden="true">@EditorIcons.Pointer</span>
            <p class="bd-empty-title">Nothing selected</p>
            <p>Click an element in the form to change its label, path, validation and rules.</p>
            @if (RootModel != null)
            {
                <button class="bd-select-form-button" @onclick="SelectForm">Edit the whole form</button>
            }
        </div>
    }
</div>

@code {
    [CascadingParameter] 
    public SelectionStateService? SelectionState { get; set; }
    
    [CascadingParameter]
    public DynamicFormModel? RootModel { get; set; }

    /// <summary>The pane's close button was pressed.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    private ElementReference labelInput;
    
    private enum EditorTab { Properties, Rules, Json }

    private EditorTab activeTab = EditorTab.Properties;
    private bool showJsonView => activeTab == EditorTab.Json;
    private bool isFullFormJsonMode = false;

    // text of a rule's schema that does not parse yet, and why, by rule index
    private readonly Dictionary<int, string> ruleDrafts = new();
    private readonly Dictionary<int, string> ruleErrors = new();
    private string selectedElementJson = "";
    private string fullFormJson = "";
    private string currentJsonContent = "";
    private bool hasJsonError = false;
    private DynamicFormModelParser jsonParser = new DynamicFormModelParser();

    protected override void OnInitialized()
    {
        if (SelectionState != null)
        {
            SelectionState.StateChanged += OnSelectionChanged;
            SelectionState.PropertiesRequested += OnPropertiesRequested;
        }
    }

    // someone asked to edit the properties (a button on the element, a double click): the first input is where to start typing
    private void OnPropertiesRequested()
    {
        activeTab = EditorTab.Properties;
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (SelectionState?.FocusRequested != true || SelectionState.SelectedElement == null) return;

        SelectionState.FocusRequested = false;
        if (labelInput.Id != null)
        {
            try { await labelInput.FocusAsync(); }
            catch (InvalidOperationException) { /* the input is gone again: nothing to focus */ }
        }
    }

    private Task Close() => OnClose.InvokeAsync();
    
    private void OnSelectionChanged()
    {
        ruleDrafts.Clear(); ruleAdvanced.Clear();
        ruleErrors.Clear();
        if (showJsonView)
        {
            UpdateJsonContent();
        }
        StateHasChanged();
    }

    public void Dispose()
    {
        if (SelectionState != null)
        {
            SelectionState.StateChanged -= OnSelectionChanged;
            SelectionState.PropertiesRequested -= OnPropertiesRequested;
        }
    }

    private void SelectParent() => SelectionState?.SelectParent();

    private void Duplicate() => SelectionState?.DuplicateSelected();

    private string GetParameterValue(DynamicFormModel element, string parameterName)
    {
        if (element.Parameters.Entries.TryGetValue(parameterName, out var value))
        {
            return value?.ToString() ?? "";
        }
        return "";
    }

    private bool GetBooleanParameter(DynamicFormModel element, string parameterName)
    {
        if (element.Parameters.Entries.TryGetValue(parameterName, out var value))
        {
            return value is bool boolValue && boolValue;
        }
        return false;
    }

    private void UpdateParameter(DynamicFormModel element, string parameterName, string? newValue)
    {
        if (newValue != null)
        {
            element.Parameters.Add(parameterName, newValue);
            ModelEdited();
        }
    }

    private void UpdateParameter(DynamicFormModel element, string parameterName, bool? newValue)
    {
        if (newValue.HasValue)
        {
            element.Parameters.Add(parameterName, newValue.Value);
            ModelEdited();
        }
    }

    private void UpdateNumericParameter(DynamicFormModel element, string parameterName, string? newValue)
    {
        if (string.IsNullOrWhiteSpace(newValue))
        {
            // Remove parameter if empty
            if (element.Parameters.Entries.ContainsKey(parameterName))
            {
                element.Parameters.Entries.Remove(parameterName);
            }
        }
        else if (double.TryParse(newValue, out var numValue))
        {
            // Min may not exceed Max; an impossible range is refused (the input snaps back on re-render)
            var otherName = parameterName == "Min" ? "Max" : "Min";
            if (element.Parameters.Entries.TryGetValue(otherName, out var other) && other != null
                && double.TryParse(Convert.ToString(other, System.Globalization.CultureInfo.InvariantCulture), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var otherValue)
                && (parameterName == "Min" ? numValue > otherValue : numValue < otherValue))
            {
                StateHasChanged();
                return;
            }
            element.Parameters.Add(parameterName, numValue);
        }
        ModelEdited();
    }

    private Dictionary<object, string> GetDropdownOptions(DynamicFormModel element)
    {
        if (element.Parameters.Entries.TryGetValue("Options", out var value) && 
            value is Dictionary<object, string> options)
        {
            return options;
        }
        return new Dictionary<object, string>();
    }

    private void UpdateOptionKey(DynamicFormModel element, object oldKey, string? newKey)
    {
        if (string.IsNullOrWhiteSpace(newKey) || Equals(oldKey?.ToString(), newKey)) return;

        var options = GetDropdownOptions(element);
        // a key that is already in use would overwrite that option, so the rename is refused (the input snaps back on re-render)
        if (options.Keys.Any(k => k?.ToString() == newKey))
        {
            StateHasChanged();
            return;
        }

        // rebuild so the renamed option keeps its place in the list
        var renamed = new Dictionary<object, string>();
        foreach (var option in options)
        {
            renamed[Equals(option.Key, oldKey) ? newKey : option.Key] = option.Value;
        }
        element.Parameters.Add("Options", renamed);
        ModelEdited();
    }

    private void UpdateOptionValue(DynamicFormModel element, object key, string? newValue)
    {
        var options = GetDropdownOptions(element);
        if (options.ContainsKey(key))
        {
            options[key] = newValue ?? "";
            element.Parameters.Add("Options", options);
            ModelEdited();
        }
    }

    private void RemoveOption(DynamicFormModel element, object key)
    {
        var options = GetDropdownOptions(element);
        if (options.Remove(key))
        {
            element.Parameters.Add("Options", options);
            ModelEdited();
        }
    }

    private void AddOption(DynamicFormModel element)
    {
        var options = GetDropdownOptions(element);
        var optionCount = options.Count + 1;
        while (options.Keys.Any(k => k?.ToString() == $"option{optionCount}"))
        {
            optionCount++;
        }
        options[$"option{optionCount}"] = $"Option {optionCount}";
        element.Parameters.Add("Options", options);
        ModelEdited();
    }

    private void ModelEdited()
    {
        SelectionState?.NotifyModelChanged();
        StateHasChanged();
    }

    private void DeleteSelectedElement() => SelectionState?.DeleteSelected();

    private void ToggleJsonView() => SetTab(showJsonView ? EditorTab.Properties : EditorTab.Json);

    private void SetTab(EditorTab tab)
    {
        activeTab = tab;
        if (showJsonView)
        {
            UpdateJsonContent();
        }
        StateHasChanged();
    }

    private void SelectForm() => SelectionState?.SelectElement(RootModel);

    // the whole form is what the JSON of the root element is
    private bool JsonIsFullForm => isFullFormJsonMode || (SelectionState?.SelectedElement != null && SelectionState.SelectedElement == RootModel);

    // parameters that have their own input above, or that only the editor's own JSON can show
    private static readonly HashSet<string> HandledSettings = new() { "Label", "Path", "Options", "Required", "Min", "Max" };

    private IEnumerable<KeyValuePair<string, object?>> OtherSettings(DynamicFormModel element) =>
        element.Parameters.Entries.Where(e => !HandledSettings.Contains(e.Key)).ToList();

    private static bool IsNumber(object? value) =>
        value is int or long or short or byte or float or double or decimal;

    private static string Humanize(string name)
    {
        var text = System.Text.RegularExpressions.Regex.Replace(name, "(?<=[a-z])(?=[A-Z])", " ");
        return text.Length == 0 ? text : char.ToUpper(text[0]) + text[1..].ToLower();
    }

    private void UpdateSettingNumber(DynamicFormModel element, string name, string? text)
    {
        if (!double.TryParse(text, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var number)) return;

        // a whole number stays a whole number
        var wasWhole = element.Parameters.Entries.TryGetValue(name, out var old) && old is int or long or short or byte;
        element.Parameters.Add(name, wasWhole && number == Math.Floor(number) ? (object)(long)number : number);
        ModelEdited();
    }

    private static string EffectLabel(RuleEffect effect) => effect switch
    {
        RuleEffect.HIDE => "Hide",
        RuleEffect.SHOW => "Show",
        RuleEffect.DISABLE => "Disable",
        RuleEffect.ENABLE => "Enable",
        _ => effect.ToString()
    };

    private static string EffectHelp(RuleEffect effect) => effect switch
    {
        RuleEffect.HIDE => "Hidden while the condition matches.",
        RuleEffect.SHOW => "Only shown while the condition matches.",
        RuleEffect.DISABLE => "Disabled while the condition matches.",
        RuleEffect.ENABLE => "Only enabled while the condition matches.",
        _ => ""
    };

    private void AddRule(DynamicFormModel element)
    {
        element.Rules ??= new List<DynamicFormModelRule>();
        element.Rules.Add(new DynamicFormModelRule(RuleEffect.HIDE,
            new DynamicFormModelRuleCondition("$.isChecked", Newtonsoft.Json.Linq.JToken.Parse("{ \"const\": true }"))));
        ModelEdited();
    }

    private void RemoveRule(DynamicFormModel element, int index)
    {
        if (element.Rules == null || index >= element.Rules.Count) return;

        element.Rules.RemoveAt(index);
        // no rules left reads the same as never having had any
        if (element.Rules.Count == 0) element.Rules = null;
        ruleDrafts.Clear(); ruleAdvanced.Clear();
        ruleErrors.Clear();
        ModelEdited();
    }

    // a rule is read-only once made, so an edit replaces it
    private void ReplaceRule(DynamicFormModel element, int index, Func<DynamicFormModelRule, DynamicFormModelRule> change)
    {
        if (element.Rules == null || index >= element.Rules.Count) return;

        element.Rules[index] = change(element.Rules[index]);
        ModelEdited();
    }

    private void UpdateRuleEffect(DynamicFormModel element, int index, string? effect)
    {
        if (!Enum.TryParse<RuleEffect>(effect, out var parsed)) return;
        ReplaceRule(element, index, rule => new DynamicFormModelRule(parsed, rule.Condition));
    }

    private void UpdateRuleScope(DynamicFormModel element, int index, string? scope)
    {
        ReplaceRule(element, index, rule => new DynamicFormModelRule(rule.Effect,
            new DynamicFormModelRuleCondition(scope ?? "", rule.Condition.Schema)));
    }

    private readonly HashSet<int> ruleAdvanced = new();

    // a rule that only compares one value ({ "const": x }) is edited as that value
    private static bool IsSimpleRule(DynamicFormModelRule rule, out string text)
    {
        text = "";
        if (rule.Condition.Schema is Newtonsoft.Json.Linq.JObject obj && obj.Count == 1
            && obj["const"] is Newtonsoft.Json.Linq.JValue value && value.Type != Newtonsoft.Json.Linq.JTokenType.Null)
        {
            text = value.Type == Newtonsoft.Json.Linq.JTokenType.Boolean ? ((bool)value.Value! ? "true" : "false")
                : value.Type == Newtonsoft.Json.Linq.JTokenType.String ? QuoteIfAmbiguous((string?)value.Value ?? "")
                : Convert.ToString(value.Value, System.Globalization.CultureInfo.InvariantCulture) ?? "";
            return true;
        }
        return false;
    }

    // the text "true" or "5" would read back as a boolean or number, so it is shown in quotes
    private static string QuoteIfAmbiguous(string s) =>
        ParseSimpleValue(s) is Newtonsoft.Json.Linq.JValue v && v.Type != Newtonsoft.Json.Linq.JTokenType.String ? $"\"{s}\"" : s;

    private static Newtonsoft.Json.Linq.JToken ParseSimpleValue(string? text)
    {
        text = (text ?? "").Trim();
        if (bool.TryParse(text, out var b)) return new Newtonsoft.Json.Linq.JValue(b);
        if (long.TryParse(text, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var l)) return new Newtonsoft.Json.Linq.JValue(l);
        if (double.TryParse(text, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var d)) return new Newtonsoft.Json.Linq.JValue(d);
        if (text.Length >= 2 && text.StartsWith('"') && text.EndsWith('"')) text = text[1..^1];
        return new Newtonsoft.Json.Linq.JValue(text);
    }

    private void UpdateRuleValue(DynamicFormModel element, int index, string? text)
    {
        var schema = new Newtonsoft.Json.Linq.JObject { ["const"] = ParseSimpleValue(text) };
        ReplaceRule(element, index, rule => new DynamicFormModelRule(rule.Effect,
            new DynamicFormModelRuleCondition(rule.Condition.Scope, schema)));
    }

    private void UpdateRuleSchema(DynamicFormModel element, int index, string? text)
    {
        Newtonsoft.Json.Linq.JToken schema;
        try
        {
            schema = Newtonsoft.Json.Linq.JToken.Parse(text ?? "");
        }
        catch (Newtonsoft.Json.JsonException ex)
        {
            // keep what was typed and say what is wrong; the rule stays as it was
            ruleDrafts[index] = text ?? "";
            ruleErrors[index] = "Not valid JSON: " + ex.Message;
            StateHasChanged();
            return;
        }

        ruleDrafts.Remove(index);
        ruleErrors.Remove(index);
        ReplaceRule(element, index, rule => new DynamicFormModelRule(rule.Effect,
            new DynamicFormModelRuleCondition(rule.Condition.Scope, schema)));
    }
    
    private void ToggleJsonMode()
    {
        isFullFormJsonMode = !isFullFormJsonMode;
        UpdateJsonContent();
        StateHasChanged();
    }
    
    private void UpdateJsonContent()
    {
        if (JsonIsFullForm && RootModel != null)
        {
            UpdateJsonFromFullForm();
        }
        else if (SelectionState?.SelectedElement != null)
        {
            UpdateJsonFromElement();
        }
    }
    
    private void UpdateJsonFromFullForm()
    {
        if (RootModel != null)
        {
            try
            {
                fullFormJson = jsonParser.Serialize(RootModel);
                currentJsonContent = fullFormJson;
                hasJsonError = false;
            }
            catch
            {
                hasJsonError = true;
            }
        }
    }
    
    private void UpdateJsonFromElement()
    {
        if (SelectionState?.SelectedElement != null)
        {
            try
            {
                selectedElementJson = jsonParser.Serialize(SelectionState.SelectedElement);
                currentJsonContent = selectedElementJson;
                hasJsonError = false;
            }
            catch
            {
                hasJsonError = true;
            }
        }
    }
    
    private void OnJsonChanged(ChangeEventArgs e)
    {
        currentJsonContent = e.Value?.ToString() ?? "";
        hasJsonError = false;
    }
    
    private void ApplyJsonChanges()
    {
        if (string.IsNullOrWhiteSpace(currentJsonContent)) return;
        
        try
        {
            if (JsonIsFullForm && RootModel != null)
            {
                ApplyFullFormJsonChanges();
            }
            else if (SelectionState?.SelectedElement != null)
            {
                ApplyElementJsonChanges();
            }
        }
        catch
        {
            hasJsonError = true;
        }
    }
    
    private void ApplyFullFormJsonChanges()
    {
        try
        {
            var newFormModel = jsonParser.Deserialize(currentJsonContent);
            if (newFormModel != null && RootModel != null)
            {
                // Replace the entire form structure
                RootModel.Elements.Clear();
                RootModel.Elements.AddRange(newFormModel.Elements);
                RootModel.Parameters = newFormModel.Parameters;
                RootModel.DynamicType = newFormModel.DynamicType;
                
                fullFormJson = currentJsonContent;
                hasJsonError = false;
                
                // Clear selection as the structure may have changed
                SelectionState?.ClearSelection();
                ModelEdited();
            }
            else
            {
                hasJsonError = true;
            }
        }
        catch
        {
            hasJsonError = true;
        }
    }
    
    private void ApplyElementJsonChanges()
    {
        try
        {
            var newElement = jsonParser.Deserialize(currentJsonContent);
            if (newElement != null && RootModel != null && SelectionState?.SelectedElement != null)
            {
                // Replace the element in the parent
                if (ReplaceElementInParent(RootModel, SelectionState.SelectedElement, newElement))
                {
                    SelectionState.SelectElement(newElement);
                    selectedElementJson = currentJsonContent;
                    hasJsonError = false;
                    ModelEdited();
                }
            }
            else
            {
                hasJsonError = true;
            }
        }
        catch
        {
            hasJsonError = true;
        }
    }
    
    private bool ReplaceElementInParent(DynamicFormModel parent, DynamicFormModel oldElement, DynamicFormModel newElement)
    {
        // Check if the element is a direct child
        var index = parent.Elements.IndexOf(oldElement);
        if (index >= 0)
        {
            parent.Elements[index] = newElement;
            return true;
        }
        
        // Recursively check children
        foreach (var child in parent.Elements)
        {
            if (ReplaceElementInParent(child, oldElement, newElement))
            {
                return true;
            }
        }
        
        return false;
    }

    private bool HasLabelProperty(ComponentType componentType)
    {
        return componentType != ComponentType.VerticalLayout && 
               componentType != ComponentType.HorizontalLayout;
    }

    private bool HasPathProperty(ComponentType componentType)
    {
        return componentType != ComponentType.VerticalLayout && 
               componentType != ComponentType.HorizontalLayout &&
               componentType != ComponentType.GroupLayout;
    }

    private bool IsNumberComponent(ComponentType componentType)
    {
        return componentType == ComponentType.Int || componentType == ComponentType.Number;
    }

    private static string GetComponentDisplayName(ComponentType componentType) => FormTree.DisplayName(componentType);
}
