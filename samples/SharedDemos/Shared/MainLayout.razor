@inherits LayoutComponentBase
@using MudBlazor;

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Elevation="0" Style="background-color:#ffffff; color:#0a0a0a; border-bottom:1px solid #e5e7eb;">
        <MudStack Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Row="true" Style="width:100%">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" aria-label="Toggle navigation" />
                <a href="/" style="font-weight:700; font-size:1rem; color:#0a0a0a; text-decoration:none; letter-spacing:-0.01em;">Blazor Dynamics</a>
            </MudStack>
            <SelectComponentsSet />
        </MudStack>
    </MudAppBar>
    <MudDrawer @bind-Open="@_drawerOpen" Elevation="0">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}


