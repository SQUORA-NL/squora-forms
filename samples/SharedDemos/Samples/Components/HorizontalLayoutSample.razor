@inherits SampleBasePage
@page "/samples/components/horizontal-layout"

<SampleDocumentation MarkDownFile="Samples.Components.HorizontalLayoutSample.razor.md" Data="@data" FormModel="@model">
    <BDForm FormModel="@model" Components="@UserSettingsService.Components" Value="@data" ValueChanged="@update"></BDForm>
</SampleDocumentation>


@code {

    private void update()
    {
        StateHasChanged();
    }

    public ExpandoObject data = new ExpandoObject();

    // without a Width the elements share the row equally; a percentage is a share of the row
    public DynamicFormModel model = FormFactory.VerticalLayout(
        FormFactory.HorizontalLayout(
            FormFactory.BoolComponent("Check", "$.check"),
            FormFactory.StringComponent("Text", "$.text")
        ),
        FormFactory.HorizontalLayout(
            FormFactory.StringComponent("10%", "$.small", b => b.WithWidth("10%")),
            FormFactory.StringComponent("90%", "$.large", b => b.WithWidth("90%"))
        )
    );
}
