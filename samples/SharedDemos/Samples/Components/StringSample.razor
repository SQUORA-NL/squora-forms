@inherits SampleBasePage
@page "/samples/components/string"

<SampleDocumentation MarkDownFile="Samples.Components.StringSample.razor.md" Data="@data" FormModel="@model" >
    <BDForm FormModel="@model" Components="@UserSettingsService.Components" Value="@data" ValueChanged="@update"></BDForm>
</SampleDocumentation>


@code {

    private void update()
    {
        StateHasChanged();
    }

    public ExpandoObject data = new ExpandoObject();

    public DynamicFormModel model = FormFactory.VerticalLayout(
        FormFactory.StringComponent("Name", "$.name"),
        // a class on one component styles only that one (.sq-highlight is in the app's css)
        FormFactory.StringComponent("Nickname (own class)", "$.nickname", b => b.WithClass("sq-highlight")));
}
