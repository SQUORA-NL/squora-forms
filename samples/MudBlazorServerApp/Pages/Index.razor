@page "/"
@using Squora.Forms.Core.Models
@using Squora.Forms.Core.Parser
@using Squora.Forms.Blazor
@using Squora.Forms.Blazor.Components.Factories
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazorServerApp.Shared
@using System.Dynamic

@inject IJSRuntime JS

<PageTitle>Form gallery</PageTitle>

<div class="demo-intro">
    <MudText Typo="Typo.h5">Form gallery</MudText>
    <MudText Typo="Typo.body2" Style="color:#64748b">
        Pick a form and fill it in. The same form, a JSON definition, renders with any of the UI libraries and themes below.
        Designing a form (dragging components, editing properties) is what the Squora Forms Designer is for.
    </MudText>
</div>

<MudStack Row="true" Spacing="2" Class="mb-3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
    <MudMenu Label="Templates" Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.KeyboardArrowDown">
        @foreach (var template in FormTemplates.All)
        {
            var t = template;
            <MudMenuItem OnClick="@(() => Load(t.Create()))">
                <MudText>@t.Name</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@t.Description</MudText>
            </MudMenuItem>
        }
    </MudMenu>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyJson">Copy JSON</MudButton>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentPaste" OnClick="PasteJson">Paste JSON</MudButton>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" OnClick="DownloadJson">Download</MudButton>
    <MudFileUpload T="IBrowserFile" Accept=".json" FilesChanged="OpenFile">
        <ActivatorContent>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile">Open file</MudButton>
        </ActivatorContent>
    </MudFileUpload>
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Code" OnClick="@(() => ToggleJsonEditor())">@(showJsonEditor ? "Hide JSON" : "Edit JSON")</MudButton>
    @if (!string.IsNullOrEmpty(status))
    {
        <MudText Typo="Typo.caption" Color="@(statusIsError ? Color.Error : Color.Success)">@status</MudText>
    }
</MudStack>

<div class="demo-style-bar">
    <div class="demo-style-group">
        <span class="demo-style-label">UI library</span>
        <MudToggleGroup T="string" Value="@frameworkKey" ValueChanged="@OnFrameworkChanged" Color="Color.Primary" Size="Size.Small"
                        SelectionMode="SelectionMode.SingleSelection" CheckMark="true" Class="demo-framework">
            @foreach (var f in FormFrameworks.All)
            {
                <MudToggleItem Value="@f.Key" Text="@f.Name" />
            }
        </MudToggleGroup>
        <span class="demo-style-note">@framework.Description</span>
    </div>
    <div class="demo-style-group">
        <span class="demo-style-label">Theme</span>
        <select class="demo-theme-select" aria-label="Form theme" value="@themeKey" @onchange="@(e => themeKey = e.Value?.ToString() ?? "default")">
            @foreach (var t in Themes)
            {
                <option value="@t.Key" selected="@(t.Key == themeKey)">@t.Name</option>
            }
        </select>
    </div>
    <div class="demo-style-group">
        <span class="demo-style-label">Accent</span>
        <div class="demo-swatches" role="radiogroup" aria-label="Accent colour">
            @foreach (var a in Accents)
            {
                var accentOption = a;
                <button type="button" role="radio" class="demo-swatch" style="--swatch:@accentOption.Color" title="@accentOption.Name" aria-label="@accentOption.Name"
                        aria-checked="@((accent == accentOption.Color).ToString().ToLower())" @onclick="@(() => accent = accentOption.Color)"></button>
            }
        </div>
    </div>
</div>

@if (showJsonEditor)
{
    <MudPaper Class="pa-3 mb-3" Outlined="true">
        <MudTextField @bind-Value="jsonText" Lines="12" Variant="Variant.Outlined" Immediate="true"
                      Label="Form JSON" Placeholder="Paste a form here" Style="font-family: monospace; font-size: 12px;" />
        <MudStack Row="true" Class="mt-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyJson">Apply</MudButton>
            <MudButton Variant="Variant.Text" OnClick="@(() => showJsonEditor = false)">Close</MudButton>
        </MudStack>
    </MudPaper>
}

@* a new key gives a new form, so nothing of the previous one (state) is carried over *@
@* the accent is --sq-accent, which the custom Contact card component takes its colour from *@
<div class="form-stage" data-form-theme="@themeKey" style="--sq-accent:@accent;">
    <BDForm @key="@($"{formVersion}-{framework.Key}")"
            FormModel=@model
            Components=@framework.Components
            Value="@data"
            ValueChanged="@update"></BDForm>
</div>

<MudCard Class="mt-3 data-card">
    <MudCardHeader Style="cursor: pointer;" @onclick="@(() => showData = !showData)">
        <CardHeaderContent>
            <MudText Typo="Typo.subtitle1">Data</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudIconButton Icon="@(showData ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           Color="Color.Default" aria-label="@(showData ? "Hide the data" : "Show the data")" />
        </CardHeaderActions>
    </MudCardHeader>
    @if (showData)
    {
        <MudCardContent>
            <JsonViewer Value="@data" />
        </MudCardContent>
    }
</MudCard>

@code
{
    private static readonly DynamicFormModelParser parser = new();

    private sealed record Accent(string Name, string Color);

    private static readonly Accent[] Accents =
    {
        new("Blue", "#2563eb"), new("Violet", "#7c3aed"), new("Teal", "#0d9488"), new("Rose", "#e11d48"), new("Slate", "#334155"),
    };

    private sealed record FormTheme(string Key, string Name);

    // the looks of the React demo; see wwwroot/css/form-themes.css
    private static readonly FormTheme[] Themes =
    {
        new("default", "Default"), new("dark", "Dark"), new("compact", "Compact"), new("studio", "Studio"),
        new("glass", "Glass"), new("neu", "Neu"), new("vintage", "Vintage"), new("card", "Card"),
    };

    private string themeKey = "default";
    private string accent = Accents[0].Color;
    private string frameworkKey = FormFrameworks.Default.Key;
    private FormFramework framework => FormFrameworks.Find(frameworkKey);

    private bool showData = true;
    private int formVersion;
    private bool showJsonEditor;
    private string jsonText = "";
    private string? status;
    private bool statusIsError;

    public ExpandoObject data = new ExpandoObject();

    public DynamicFormModel model = FormTemplates.Contact();

    private void update()
    {
        StateHasChanged();
    }

    // the form and what was filled in stay: only the components that show them change
    private async Task OnFrameworkChanged(string? key)
    {
        if (key == null || key == frameworkKey) return;
        // the theme is in place before the form is shown with the new components
        await JS.InvokeVoidAsync("useRadzenTheme", key == "radzen");
        frameworkKey = key;
    }

    private void Load(DynamicFormModel newModel)
    {
        model = newModel;
        data = new ExpandoObject();
        formVersion++;
    }

    private void Report(string message, bool error = false)
    {
        status = message;
        statusIsError = error;
    }

    private async Task CopyJson()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", parser.Serialize(model));
            Report("Copied the form JSON");
        }
        catch (JSException)
        {
            // the browser refuses clipboard access (not a secure page, or not allowed): show it to copy by hand
            ToggleJsonEditor(true);
            Report("The browser did not allow copying: select the text below and copy it", true);
        }
    }

    private async Task PasteJson()
    {
        string? text = null;
        try
        {
            text = await JS.InvokeAsync<string>("navigator.clipboard.readText");
        }
        catch (JSException)
        {
            // reading the clipboard is not allowed here: paste into the box instead
        }

        if (!string.IsNullOrWhiteSpace(text) && TryLoadJson(text)) return;

        showJsonEditor = true;
        jsonText = text ?? "";
        if (string.IsNullOrWhiteSpace(text)) Report("Paste the form JSON in the box and press Apply");
    }

    private async Task DownloadJson()
    {
        await JS.InvokeVoidAsync("downloadText", "form.json", parser.Serialize(model));
        Report("Downloaded form.json");
    }

    private async Task OpenFile(IBrowserFile? file)
    {
        if (file == null) return;
        using var reader = new StreamReader(file.OpenReadStream(1024 * 1024));
        TryLoadJson(await reader.ReadToEndAsync());
    }

    private void ToggleJsonEditor(bool? show = null)
    {
        showJsonEditor = show ?? !showJsonEditor;
        if (showJsonEditor) jsonText = parser.Serialize(model);
    }

    private void ApplyJson()
    {
        if (TryLoadJson(jsonText)) showJsonEditor = false;
    }

    private bool TryLoadJson(string json)
    {
        var loaded = parser.Deserialize(json);
        if (loaded == null)
        {
            Report("That is not a valid form JSON", true);
            return false;
        }

        Load(loaded);
        Report("Loaded the form");
        return true;
    }
}
