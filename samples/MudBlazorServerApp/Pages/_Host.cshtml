@page "/"
@using Microsoft.AspNetCore.Components.Web
@using MudBlazorServerApp;
@namespace SIngleServerapp.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <link href="MudBlazorServerApp.styles.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="favicon.png"/>
    <component type="typeof(HeadOutlet)" render-mode="Server" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <style>
        /* the Radzen theme (loaded only while Radzen is chosen) also paints the page itself: keep the demo's own background */
        body { background: none !important; }
    </style>
    <link href="_content/Squora.Forms.Blazor.HtmlComponents/themes/default/squora-forms-html.css" rel="stylesheet" />
    <link href="_content/Squora.Forms.Blazor.MudBlazorComponents/themes/default/squora-forms-mudblazor.css" rel="stylesheet" />
    <link href="_content/Squora.Forms.Blazor.RadzenComponents/themes/default/squora-forms-radzen.css" rel="stylesheet" />
    <link href="~/css/form-themes.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <component type="typeof(App)" render-mode="Server" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="_framework/blazor.server.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js"></script>
    <script src="_content/BlazorMonaco/jsInterop.js"></script>
    <script src="_content/BlazorMonaco/lib/monaco-editor/min/vs/loader.js"></script>
    <script>require.config({ paths: { 'vs': '_content/BlazorMonaco/lib/monaco-editor/min/vs' } });</script>
    <script src="_content/BlazorMonaco/lib/monaco-editor/min/vs/editor/editor.main.js"></script>
    <script>
        // the Radzen theme styles the whole page (body, links), so it is only on while the form is shown with Radzen
        window.useRadzenTheme = on => {
            let link = document.getElementById('radzen-theme');
            if (on && !link) {
                link = document.createElement('link');
                link.id = 'radzen-theme';
                link.rel = 'stylesheet';
                link.href = '_content/Radzen.Blazor/css/standard-base.css';
                document.head.appendChild(link);
            } else if (!on && link) {
                link.remove();
            }
        };
    </script>
    <script>window.downloadText = (name, text) => { const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([text], { type: 'application/json' })); a.download = name; a.click(); URL.revokeObjectURL(a.href); };</script>
    <script>window.waitForMonaco = () => new Promise(resolve => { const check = () => window.monaco ? resolve() : setTimeout(check, 50); check(); });</script>
</body>
</html>
