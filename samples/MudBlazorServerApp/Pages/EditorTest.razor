@page "/editortest"
@using Squora.Forms.Core.Models
@using Squora.Forms.Blazor.Components.Factories
@using Squora.Forms.Blazor
@using System.Dynamic

<PageTitle>Editor Test</PageTitle>

<h1>Form Editor Test</h1>

<div style="margin-bottom: 20px;">
    <label style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px;">
        <input type="checkbox" @bind="EditModeIndicator" />
        <span>Edit Mode (Enable Drag & Drop)</span>
    </label>
    @if (EditModeIndicator)
    {
        <div style="padding: 10px; background-color: #e3f2fd; border-radius: 4px; margin-bottom: 10px;">
            <strong>Editor Instructions:</strong><br/>
            • Select a form element to see its properties<br/>
            • Use the delete button to remove elements<br/>
            • Use the JSON button to view/edit the element's JSON
        </div>
    }
</div>

<BDForm FormModel=@model Value="@data" ValueChanged="@update" EditMode=@EditModeIndicator></BDForm>

@code {
    private bool EditModeIndicator = true;
    private ExpandoObject data = new ExpandoObject();

    private DynamicFormModel model = FormFactory.VerticalLayout(
        FormFactory.GroupLayout(group =>
            group
               .WithParameter("Label", "Personal Information")
               .WithElements(
                    FormFactory.StringComponent("First Name", "$.firstName"),
                    FormFactory.StringComponent("Last Name", "$.lastName"),
                    FormFactory.StringComponent("Email", "$.email")
               )
            ),
        FormFactory.GroupLayout(group =>
            group
               .WithParameter("Label", "Address Information")
               .WithElements(
                    FormFactory.StringComponent("Street", "$.address.street"),
                    FormFactory.StringComponent("City", "$.address.city"),
                    FormFactory.StringComponent("ZIP Code", "$.address.zip")
               )
            ),
        FormFactory.HorizontalLayout(
            FormFactory.BoolComponent("Subscribe to Newsletter", "$.subscribe"),
            FormFactory.BoolComponent("Accept Terms", "$.acceptTerms")
        )
    );

    private void update()
    {
        StateHasChanged();
    }
}