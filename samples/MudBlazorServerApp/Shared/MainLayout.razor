@using MudBlazor;
@inherits LayoutComponentBase

<MudThemeProvider Theme="@theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Style="background-color:#ffffff; color:#0a0a0a; border-bottom:1px solid #e5e7eb;">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" aria-label="Toggle navigation" />
        My Application
    </MudAppBar>
    
    <MudDrawer @bind-Open="@_drawerOpen">
        <NavMenu/>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true;

    // the same blue as the editor's own buttons
    private readonly MudTheme theme = new()
    {
        PaletteLight = new PaletteLight { Primary = "#007bff" }
    };

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}
