@inherits Squora.Forms.Blazor.Components.Layout.GroupLayoutBase

<BDFormComponentWrapper Class="groupcomponent" FormComponent="@this">
    @* while editing, the content is always shown: a collapsed group has nowhere to drop into *@
    @if (collapsed && !EditMode)
    {
        <MudCard>
            <MudCardHeader>
                <MudStack AlignItems="AlignItems.Stretch" Row=true>
                    @if (!string.IsNullOrEmpty(Label))
                    {
                        <MudText>@Label</MudText>
                    }
                    <MudButton OnClick="@Toggle" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ExpandMore">Expand</MudButton>
                </MudStack>
            </MudCardHeader>
            <MudCardContent>
                <MudStack>
                    <DynamicComponent Type=@GetComponentTypeFor(HeaderModel) Parameters=@GetValidParametersFor(HeaderModel) />
                </MudStack>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <MudCard>
            <MudCardHeader>
                <MudStack AlignItems="AlignItems.Stretch" Row=true>
                    @if (!string.IsNullOrEmpty(Label))
                    {
                        <MudText>@Label</MudText>
                    }
                    <MudButton OnClick="@Toggle" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ExpandLess">Collapse</MudButton>
                </MudStack>
            </MudCardHeader>

            <MudCardContent>
                <MudStack>
                    @for (int i = 0; i < this.FormModel.Elements.Count; i++)
                    {
                        var element = this.FormModel.Elements[i];
                        <DynamicComponent Type=@GetComponentTypeFor(element) Parameters=@GetValidParametersForChild(element, i) />
                    }
                    @if (EditMode && this.FormModel.Elements.Count == 0)
                    {
                        <BDEmptyDropZone Container="@this" />
                    }
                </MudStack>
            </MudCardContent>
        </MudCard>
    }
</BDFormComponentWrapper>

@code {
    private bool collapsed;
    [Parameter]
    public bool StartCollapsed { get; set; } = true;

    [Parameter]
    public DynamicFormModel HeaderModel { get; set; } = new();

    protected override void OnInitialized()
    {
        collapsed = StartCollapsed; // Set the initial state only once
    }

    protected override void OnParametersSet()
    {
        // the group is open while editing, and stays open when editing stops
        if (EditMode) collapsed = false;
    }

    private void Toggle()
    {
        collapsed = !collapsed;
    }
}
